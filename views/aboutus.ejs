<!-- Stats counter -->
<script>
(function () {
  var statsBlock = document.querySelector('[data-stats]');
  if (!statsBlock) return;

  var counters = statsBlock.querySelectorAll('[data-count-to]');

  function animateCounter(el) {
    var target = parseFloat(el.getAttribute('data-count-to'));
    var decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);
    var suffix = el.getAttribute('data-suffix') || '';
    var duration = 1300;
    var start = null;
    function step(timestamp) {
      if (!start) start = timestamp;
      var progress = Math.min((timestamp - start) / duration, 1);
      var eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = (eased * target).toFixed(decimals) + suffix;
      if (progress < 1) requestAnimationFrame(step);
      else el.textContent = target.toFixed(decimals) + suffix;
    }
    requestAnimationFrame(step);
  }

  var hasAnimated = false;
  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting && !hasAnimated) {
        hasAnimated = true;
        statsBlock.classList.add('is-visible');
        counters.forEach(animateCounter);
        observer.disconnect();
      }
    });
  }, { threshold: 0.3 });

  observer.observe(statsBlock);
})();
</script>

<!-- Story timeline -->
<script>
(function () {
  var deck = document.querySelector('[data-story]');
  if (!deck) return;

  // ---- Tuning ----
  var CARD_MAX = 560;   // widest the front card gets (px)
  var SHRINK   = 0.04;  // how much smaller each card gets per step back
  var MIN_STEP = 26;    // narrowest strip each back card shows (px), used on small screens
  var TAG_MIN  = 96;    // only show the year in a strip if it is at least this wide

  var stage = deck.querySelector('.story-deck__stage');
  var cards = [].slice.call(deck.querySelectorAll('.story-card'));
  var items = [].slice.call(deck.querySelectorAll('.story-rail__item'));
  var prev  = deck.querySelector('[data-story-prev]');
  var next  = deck.querySelector('[data-story-next]');
  var active = 0;
  var maxPos = cards.length - 1;

  // Add a year tag to each card (shown in the strip when the card sits behind)
  cards.forEach(function (card) {
    var yearEl = card.querySelector('.story-card__year');
    var tag = document.createElement('span');
    tag.className = 'story-card__tag';
    tag.setAttribute('aria-hidden', 'true');
    tag.textContent = yearEl ? yearEl.textContent : '';
    card.insertBefore(tag, card.firstChild);
  });

  function render() {
    cards.forEach(function (card, i) {
      var pos = i - active;
      card.style.setProperty('--pos', Math.max(pos, 0));
      card.setAttribute('data-pos', pos < 0 ? 'past' : String(pos));
      card.setAttribute('aria-hidden', pos === 0 ? 'false' : 'true');
    });
    items.forEach(function (btn, i) {
      btn.classList.toggle('is-active', i === active);
      btn.classList.toggle('is-done', i < active);
      btn.setAttribute('aria-current', i === active ? 'true' : 'false');
    });
    if (prev) prev.disabled = active === 0;
    if (next) next.disabled = active === cards.length - 1;
  }

  function go(i) {
    active = Math.min(Math.max(i, 0), cards.length - 1);
    render();
  }

  // Size the stack to fill the container, then match all card heights
  function layout() {
    var stageW = stage.clientWidth;
    var cardW = Math.min(CARD_MAX, (stageW - maxPos * MIN_STEP) / (1 - maxPos * SHRINK));
    var step = maxPos ? (stageW - cardW * (1 - maxPos * SHRINK)) / maxPos : 0;

    deck.style.setProperty('--card-w', cardW + 'px');
    deck.style.setProperty('--step', step + 'px');
    deck.style.setProperty('--shrink', SHRINK);
    deck.classList.toggle('has-tags', step >= TAG_MIN);

    var tallest = 0;
    cards.forEach(function (c) { c.style.height = 'auto'; });
    cards.forEach(function (c) { tallest = Math.max(tallest, c.offsetHeight); });
    cards.forEach(function (c) { c.style.height = tallest + 'px'; });
    stage.style.height = tallest + 'px';
  }

  cards.forEach(function (card, i) {
    card.addEventListener('click', function () { if (i > active) go(i); });
  });
  items.forEach(function (btn, i) {
    btn.addEventListener('click', function () { go(i); });
  });
  if (prev) prev.addEventListener('click', function () { go(active - 1); });
  if (next) next.addEventListener('click', function () { go(active + 1); });

  deck.addEventListener('keydown', function (e) {
    if (e.key === 'ArrowRight') { go(active + 1); e.preventDefault(); }
    if (e.key === 'ArrowLeft')  { go(active - 1); e.preventDefault(); }
  });

  // Swipe
  var startX = null;
  stage.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; }, { passive: true });
  stage.addEventListener('touchend', function (e) {
    if (startX === null) return;
    var dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 40) go(active + (dx < 0 ? 1 : -1));
    startX = null;
  }, { passive: true });

  window.addEventListener('resize', layout);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(layout);
  layout();
  render();
})();
</script>
