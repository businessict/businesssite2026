/* Footnote engine: numbers follow order of first appearance */
const cited = [];
const counts = {};
const fn = (key) => {
  if (!sources[key]) { return '<sup class="fn-ref fn-ref--missing">?</sup>'; }
  let idx = cited.indexOf(key);
  if (idx === -1) { cited.push(key); idx = cited.length - 1; counts[key] = 0; }
  counts[key] += 1;
  const n = idx + 1;
  const label = 'Footnote ' + n + ': ' + sources[key].publisher;
  const tip = (sources[key].publisher + ': ' + sources[key].title).replace(/"/g, '&quot;');
  return '<sup class="fn-ref"><a href="#fn-' + n + '" id="fnref-' + n + '-' + counts[key] + '" aria-label="' + label + '" data-tip="' + tip + '">' + n + '</a></sup>';
};

