<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= pageTitle %></title>
<meta name="description" content="<%= metaDescription %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="/css/base.css">
<link rel="icon" href="/images/favicon.ico">
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</head>
<body>

<%- include('partials/header') %>

<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">Get in touch</span>
    <h1>Let's get your business connected.</h1>
    <p>Request a call back or send us a message.<br>A local expert will be in touch, no obligation.</p>
  </div>
</section>

<% if (locals.error) { %>
  <p style="color: red; margin-bottom: 1rem;">Something went wrong. Please check the form and try again, or call us directly.</p>
<% } %>

<section>
  <div class="wrap contact-grid">
    <form class="contact-form" action="/contact" method="POST">
      <div>
        <label for="name">Full name *</label>
        <input type="text" id="name" name="name" autocomplete="name" required>
      </div>
      <div>
        <label for="company">Business name *</label>
        <input type="text" id="company" name="company" autocomplete="organization" required>
      </div>
      <div>
        <label for="email">Email *</label>
        <input type="email" id="email" name="email" autocomplete="email" required>
      </div>
      <div>
        <label for="phone">Phone *</label>
        <input type="tel" id="phone" name="phone" autocomplete="tel" required>
      </div>
      <div>
        <label for="interest">I'm interested in *</label>
        <select id="interest" name="interest" required>
          <option value="" disabled selected>Please select</option>
          <option value="high-speed-internet">High Speed Internet</option>
          <option value="mobility">Mobility</option>
          <option value="unified-comms">Unified Comms</option>
          <option value="managed-it">Managed IT Services</option>
          <option value="managed-print">Managed Print</option>
          <option value="hardware">Hardware Procurement</option>
          <option value="myaccount-demo">MyAccount Demo</option>
          <option value="other">Something else</option>
        </select>
      </div>
      <div>
        <label for="message">Message (optional)</label>
        <textarea id="message" name="message" rows="4"></textarea>
      </div>

      <!-- Spam trap: hidden from people, bots fill it in -->
      <div style="position:absolute; left:-9999px;" aria-hidden="true">
        <label for="website">Leave this field empty</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
      </div>

      <!-- Captcha -->
      <div class="cf-turnstile"
           data-sitekey="<%= locals.turnstileSiteKey || '' %>"
           data-callback="onCaptchaDone"
           data-expired-callback="onCaptchaExpired"
           data-error-callback="onCaptchaExpired"></div>

      <button type="submit" id="contact-submit" class="btn btn--primary" style="width: auto; display: inline-flex; align-self: flex-start; justify-self: start;" disabled>Submit</button>
    </form>

    <div class="contact-info-card">
      <h3>Talk to a local expert</h3>
      <p>Our main office locations are listed below. <br> We service Australia wide.
        <br><br>
        <strong>Melbourne Office:</strong> <br>
1A, 18-24 Ricketts Road, Mount Waverley VIC 3149
<br><br>
<strong>Sydney Office:</strong> <br>
203/275 Alfred Street, North Sydney NSW 2060<br> 
      </p>
      <ul>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span><a href="tel:1300988505">1300 988 505</a></span>
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 4h16v16H4z" stroke="currentColor" stroke-width="1.6"/><path d="M4 5l8 7 8-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span><a href="mailto:info@businessict.com.au">info@businessict.com.au</a></span>
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 22s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12z" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="10" r="2.4" stroke="currentColor" stroke-width="1.6"/></svg>
          <span>Servicing businesses across Australia</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

<script src="/js/main.js" defer></script>
<script>
  // The Submit button stays disabled until the captcha has been passed
  function onCaptchaDone() {
    document.getElementById('contact-submit').disabled = false;
  }
  function onCaptchaExpired() {
    document.getElementById('contact-submit').disabled = true;
  }
</script>
</body>
</html>

