<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= pageTitle %></title>
<meta name="description" content="<%= metaDescription %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="/css/style.css">
<link rel="icon" href="/images/favicon.ico">
</head>
<body>

<%- include('partials/header') %>

<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">Get in touch</span>
    <h1>Let's get your business connected.</h1>
    <p>Request a call back or send us a message — a local expert will be in touch, no obligation.</p>
  </div>
</section>

<section>
  <div class="wrap contact-grid">
    <form class="contact-form" action="/contact" method="POST" novalidate>
      <div>
        <label for="name">Full name</label>
        <input type="text" id="name" name="name" autocomplete="name" required>
      </div>
      <div>
        <label for="company">Business name</label>
        <input type="text" id="company" name="company" autocomplete="organization">
      </div>
      <div>
        <label for="email">Email</label>
        <input type="email" id="email" name="email" autocomplete="email" required>
      </div>
      <div>
        <label for="phone">Phone</label>
        <input type="tel" id="phone" name="phone" autocomplete="tel">
      </div>
      <div>
        <label for="interest">I'm interested in</label>
        <select id="interest" name="interest">
          <option value="mobility">Mobility</option>
          <option value="unified-comms">Unified Comms</option>
          <option value="managed-it">Managed IT Services</option>
          <option value="managed-print">Managed Print</option>
          <option value="hardware">Hardware Procurement</option>
          <option value="other">Something else</option>
        </select>
      </div>
      <div>
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="4"></textarea>
      </div>
      <button type="submit" class="btn btn--primary">Request a call</button>
    </form>

    <div class="contact-info-card">
      <h3>Talk to a local expert</h3>
      <p>We're happy to answer questions, no pressure and no obligation.</p>
      <ul>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>1800 000 000 &mdash; Mon&ndash;Fri, 8am&ndash;6pm AEST</span>
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 4h16v16H4z" stroke="currentColor" stroke-width="1.6"/><path d="M4 5l8 7 8-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span><a href="mailto:info@businessict.com.au">info@businessict.com.au</a></span>
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 22s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12z" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="10" r="2.4" stroke="currentColor" stroke-width="1.6"/></svg>
          <span>Servicing businesses across Australia</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

<script src="/js/main.js" defer></script>
</body>
</html>
