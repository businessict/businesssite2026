      <% var logos = [
        'Aim','Bata','bing','BlacknDecker','Blundstone','Bosistos','bowens','bowls',
        'Braun','britex','Chemist','cool','de','EUKY','Exxim','GJK',
        'Greenbynature','Jellis','Livelife','McColls','oapl','Oped','Paragon','RainHorne',
        'ray','seaworld','SecureCorp','Smaart','vicks','Woodards','Yellow','professionals'
      ]; %>
      <% [0, 1].forEach(function(copy){ %>
        <% logos.forEach(function(name){ %>
