      <% var network = [
        { file: '3cx', name: '3CX' },
        { file: 'cisco', name: 'Cisco' },
        { file: 'crowd', name: 'CrowdStrike' },
        { file: 'kyo', name: 'Kyocera' },
        { file: 'Microsoft', name: 'Microsoft' },
        { file: 'Lenovo', name: 'Lenovo' },
        { file: 'nbnlogo', name: 'nbn' },
