<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= pageTitle %></title>
<meta name="description" content="<%= metaDescription %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="/css/style.css">
<link rel="icon" href="/images/favicon.ico">
</head>
<body>

<%- include('partials/header') %>

<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">Products &amp; Services</span>
    <h1>Unified Comms</h1>
    <p>Modern businesses need communication that's seamless, flexible, and built for the way teams actually work. We deliver integrated voice and collaboration solutions that keep your people connected in the office, on the road, or working remotely.</p>
    <a href="/contact" class="btn btn--primary">Schedule an obligation-free chat</a>
  </div>
</section>

<section>
  <div class="wrap">

    <div class="section-head">
      <div class="section-head__copy">
        <h1>Plans that scale with your team</h1>
        <p>Start with cloud calling and add video, analytics or a full contact centre as you grow — no re-platforming required.</p>
      </div>
    </div>

    <div class="carousel" data-carousel>
      <div class="carousel__viewport">

        <article class="plan-card">
          <p class="plan-card__name">Essentials</p>
          <p class="plan-card__data">1<span>seat / user</span></p>
          <p class="plan-card__sub">Cloud calling for small teams</p>
          <ul class="plan-card__list">
            <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Cloud PBX &amp; auto attendant</li>
            <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Desktop &amp; mobile app</li>
            <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Voicemail to email</li>
          </ul>
          <a href="/contact" class="btn btn--primary btn--sm">Schedule a chat</a>
        </article>

        <article class="plan-card">
          <p class="plan-card__name">Team</p>
          <p class="plan-card__data">1<span>seat / user</span></p>
          <p class="plan-card__sub">Voice, video and messaging together</p>
          <ul class="plan-card__list">
            <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Everything in Essentials</li>
            <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> HD video meetings</li>
            <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Team messaging &amp; file share</li>
            <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Call queues</li>
          </ul>
          <a href="/contact" class="btn btn--primary btn--sm">Schedule a chat</a>
        </article>

        <article class="plan-card">
          <p class="plan-card__name">Business</p>
          <p class="plan-card__data">1<span>seat / user</span></p>
          <p class="plan-card__sub">Advanced call handling for growing teams</p>
          <ul class="plan-card__list">
            <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Everything in Team</li>
            <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Call analytics &amp; reporting</li>
            <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> CRM integrations</li>
          </ul>
          <a href="/contact" class="btn btn--primary btn--sm">Schedule a chat</a>
        </article>

        <article class="plan-card">
          <p class="plan-card__name">Enterprise</p>
          <p class="plan-card__data">1<span>seat / user</span></p>
          <p class="plan-card__sub">Custom-built for multi-site organisations</p>
          <ul class="plan-card__list">
            <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Everything in Business</li>
            <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Contact centre features</li>
            <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Dedicated account manager</li>
            <li><svg width="16" height="16" viewBox="0 0 16 16"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> Custom SLA</li>
          </ul>
          <a href="/contact" class="btn btn--primary btn--sm">Schedule a chat</a>
        </article>

      </div>

      <div class="carousel__controls">
        <button type="button" class="round-btn" data-carousel-prev aria-label="Previous unified comms plans">
          <svg width="16" height="16" viewBox="0 0 16 16"><path d="M10 2L4 8l6 6" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="carousel__progress"><div class="carousel__progress-bar"></div></div>
        <button type="button" class="round-btn" data-carousel-next aria-label="Next unified comms plans">
          <svg width="16" height="16" viewBox="0 0 16 16"><path d="M6 2l6 6-6 6" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
      <div class="carousel__dots"></div>
      <p class="scroll-hint">
        Swipe or drag to compare plans
        <svg width="14" height="10" viewBox="0 0 14 10" fill="none"><path d="M1 5h11M8 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </p>
    </div>
  </div>
</section>

<section class="section--tint">
  <div class="wrap" style="text-align:center;">
    <h1>Ready to unify your comms?</h1>
    <p style="margin-inline:auto;">Tell us how your team communicates and we'll map out the right setup — no pressure, no obligation.</p>
    <a href="/contact" class="btn btn--primary">Schedule an obligation-free chat</a>
  </div>
</section>

<%- include('partials/footer') %>

<script src="/js/main.js" defer></script>
</body>
</html>
