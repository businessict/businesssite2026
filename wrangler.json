{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "businessict-site",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "build": {
    "command": "node build.js"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/contact"]
  },
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF6pDpUXnvN7So8C",
    "CONTACT_FROM": "Business ICT Website <onboarding@resend.dev>",
    "CONTACT_TO": "michael.patane@businessict.com.au"
  },
  "observability": {
    "enabled": true
  }
}
